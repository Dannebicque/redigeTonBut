{% extends 'base.html.twig' %}

{% block header %}{{ apc_sae.display }}{% endblock %}

{% block content %}
    {% if compareMode|default(false) %}
        <div class="alert alert-info mb-2">
            Mode comparaison actif (N-1 -> N){% if versionPrecedente is not null %}, version précédente: {{ versionPrecedente.id }}{% endif %}.
        </div>
    {% endif %}
    {% if apc_sae.ficheAdaptationLocale == true %}
        <div class="alert alert-warning mb-2">Fiche d'adaptation locale. Non publiée et non prise en compte dans les
                                              tableaux.
        </div>
    {% endif %}
    <div class="mb-5 {% if apc_sae.ficheAdaptationLocale == true %} bg-warning text-white{% endif %}">
        {{ include('formation/apc_sae/_detail.html.twig') }}
    </div>
    {% if not is_granted('ROLE_GT') and not is_granted('ROLE_IUT') %}
        <div class="card bg-warning text-white">
            <div class="card-body ">
                {{ include('formation/apc_sae/_preconisation.html.twig') }}
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block breadcrumb %}
    {{ include('composants/breadcrumb.html.twig', {liens:[
        {
            href:'',
            title: 'B.U.T. ' ~apc_sae.semestre.annee.ordre,
        },
        {
            href: compareMode|default(false)
                ? path('but_sae_annee_comparaison', {annee: apc_sae.semestre.annee.id, parcours: selectedParcours != null ? selectedParcours.id : null, semestre: apc_sae.semestre.id})
                : path('but_sae_annee', {annee: apc_sae.semestre.annee.id, parcours: selectedParcours != null ? selectedParcours.id : null, semestre: apc_sae.semestre.id}),
            title: 'Les SAÉ',
        },
    ]}) }}
{% endblock %}

{% block bouton_header %}
    <a href="{{ compareMode|default(false)
        ? path('but_sae_annee_comparaison', {annee: apc_sae.semestre.annee.id, parcours: selectedParcours != null ? selectedParcours.id : null, semestre: apc_sae.semestre.id})
        : path('but_sae_annee', {annee: apc_sae.semestre.annee.id, parcours: selectedParcours != null ? selectedParcours.id : null, semestre: apc_sae.semestre.id})
    }}" class="btn btn-sm btn-outline-info
        btn-icon btn-icon-end w-100 w-sm-auto mx-2"
    >
        <i class="bi-arrow-left-circle"></i>
        <span>Retour</span>
    </a>
