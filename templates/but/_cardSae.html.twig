<div class="col-md-4 col-sm-12">
    <div class="card {% if sae.ficheAdaptationLocale == true %}bg-warning text-white{% endif %}">
        <div class="card-body">
            {% set pdfStatusData = pdfStatusBySae[sae.id]|default({'status': 'absent', 'errorMessage': null, 'lastGeneratedAt': null}) %}
            <h4 class="card-title">{{ sae.display }}
                <span class="badge badge-primary">
                    {{ sae.semestre.libelle }}
                </span>
            </h4>
            {% if compareMode|default(false) and saeDiff is not null %}
                {% if saeDiff.status == 'added' %}
                    <span class="badge bg-success mb-2">Ajoutee depuis N-1</span>
                {% elseif saeDiff.status == 'changed' %}
                    <span class="badge bg-warning text-dark mb-2">Modifiee</span>
                {% else %}
                    <span class="badge bg-secondary mb-2">Identique</span>
                {% endif %}
            {% endif %}
            <div>
                {% set parcoursPdfId = parcours is defined and parcours is not null ? parcours.id : null %}
                {% for parcoursItem in sae.apcSaeParcours %}
                    <div class="d-flex mb-2">
                        <span class="badge badge-parcours-{{ parcoursItem.parcours.couleur }} me-2">
                            {{ parcoursItem.parcours.code }}
                        </span>
                        <div><i>{{ parcoursItem.parcours.libelle }}</i></div>
                    </div>
                    {% if parcoursPdfId is null %}
                        {% set parcoursPdfId = parcoursItem.parcours.id %}
                    {% endif %}
                {% else %}
                    <div class="d-flex">
                        <span class="badge bg-success me-2">Tous</span>
                        <div>Tous les parcours</div>
                    </div>
                {% endfor %}
            </div>
            <p>{{ sae.objectifs != null ? sae.objectifs | markdown_to_html : ''}}</p>
            {% if compareMode|default(false) and saeDiff is not null and saeDiff.status == 'changed' %}
                <div class="small text-muted mb-2">
                    {% if saeDiff.changes.objectifs is defined %}
                        <div><strong>Objectifs:</strong> modifies</div>
                    {% endif %}
                    {% if saeDiff.changes.description is defined %}
                        <div><strong>Description:</strong> modifiee</div>
                    {% endif %}
                    {% if saeDiff.changes.heuresTotales is defined %}
                        <div><strong>Heures:</strong> {{ saeDiff.changes.heuresTotales.old }} -> {{ saeDiff.changes.heuresTotales.new }}</div>
                    {% endif %}
                    {% if saeDiff.changes.tpPpn is defined %}
                        <div><strong>TP:</strong> {{ saeDiff.changes.tpPpn.old }} -> {{ saeDiff.changes.tpPpn.new }}</div>
                    {% endif %}
                    {% if saeDiff.changes.projetPpn is defined %}
                        <div><strong>PTUT:</strong> {{ saeDiff.changes.projetPpn.old }} -> {{ saeDiff.changes.projetPpn.new }}</div>
                    {% endif %}
                    {% if saeDiff.linkedChanges is defined and (saeDiff.linkedChanges.acs.added|length > 0 or saeDiff.linkedChanges.acs.removed|length > 0) %}
                        <div><strong>AC:</strong> modifies</div>
                    {% endif %}
                    {% if saeDiff.linkedChanges is defined and (saeDiff.linkedChanges.ressources.added|length > 0 or saeDiff.linkedChanges.ressources.removed|length > 0) %}
                        <div><strong>Ressources mobilisees:</strong> modifiees</div>
                    {% endif %}
                </div>
            {% endif %}
            <p>
                {% for competence in sae.apcSaeCompetences %}
                    <span class="badge badge-{{ competence.competence.couleur }}">
                        {{ competence.competence.nomCourt }}</span>
                {% endfor %}
            </p>
        </div>
        <div class="card-footer text-end">
            <div class="col-12 d-flex align-items-center justify-content-md-end mb-2">
                {% if pdfStatusData.status == 'present' %}
                    <span class="badge bg-success me-2">PDF disponible</span>
                {% elseif pdfStatusData.status == 'pending' %}
                    <span class="badge bg-warning text-dark me-2">Generation en attente</span>
                {% elseif pdfStatusData.status == 'error' %}
                    <span class="badge bg-danger me-2" title="{{ pdfStatusData.errorMessage|default('Erreur de generation PDF') }}">Erreur PDF</span>
                {% else %}
                    <span class="badge bg-secondary me-2">PDF non genere</span>
                {% endif %}
                {% if pdfStatusData.lastGeneratedAt is not null %}
                    <small class="text-muted me-2">{{ pdfStatusData.lastGeneratedAt|date('d/m/Y H:i') }}</small>
                {% endif %}
                <a href="{{ path('pdf_show',
                    {sourceType: 'sae', 'sourceId': sae.id, parcours: parcoursPdfId, documentKey: 'fiche' }) }}"
                   class="btn btn-block btn-sm btn-icon btn-icon-start btn-outline-primary ms-1"
                   target="_blank"
                >
                    <i class="bi-print"></i>
                    <span class="d-none d-xxl-inline-block">Afficher / generer le PDF</span>
                </a>
                <a href="{{ path('pdf_show',
                    {sourceType: 'sae', 'sourceId': sae.id, parcours: parcoursPdfId, documentKey: 'fiche', force: 1 }) }}"
                   class="btn btn-block btn-sm btn-icon btn-icon-start btn-outline-warning ms-1"
                   target="_blank"
                >
                    <i class="bi-arrow-repeat"></i>
                    <span class="d-none d-xxl-inline-block">Forcer la mise a jour</span>
                </a>
            </div>
            <a href="{{ path('but_fiche_sae',
                {'apcSae': sae.id, parcours: parcours != null ? parcours.id : null, compare: compareMode|default(false) ? 1 : null}) }}"
                class="btn btn-block btn-sm btn-icon btn-icon-start btn-outline-primary"
                target="_blank"
            >
                <i class="bi-info-circle"></i>
                <span class="d-none d-xxl-inline-block">Voir la fiche SAÉ</span>
            </a>
            {% if is_granted('ROLE_EDITEUR') %}
                <div class="col-12 d-flex align-items-center justify-content-md-end">
                    {% if user_data.version.pnVerouille == false %}
                        {% if user_data.version.verouilleCroise == false %}
                            <a href="{{ path('formation_apc_sae_duplicate',
                                {'id': sae.id, parcours: parcours != null ? parcours.id : null}) }}" class="btn btn-sm btn-icon btn-icon-start btn-outline-info ms-1"
                               type="button">
                                <i class="bi-files"></i>
                                <span class="d-none d-xxl-inline-block">Dupliquer</span>
                            </a>
                        {% endif %}
                        <a href="{{ path('formation_apc_sae_edit',
                            {'id': sae.id, parcours: parcours != null ? parcours.id : null}) }}" class="btn btn-sm btn-icon
                    btn-icon-start {% if sae.ficheAdaptationLocale == true %} btn-outline-dark text-white{% else %} btn-outline-warning{% endif %} ms-1" type="button">
                            <i class="bi-pencil-square"></i>
                            <span class="d-none d-xxl-inline-block">Modifier</span>
                        </a>
                        {% if  is_granted('ROLE_PACD') and user_data.version.verouilleCroise == false %}
                            {{ include('form/_delete_form.html.twig', {path: path('formation_apc_sae_delete',
                                {id: sae.id, }), id: sae.id}) }}
                        {% endif %}
                    {% endif %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
