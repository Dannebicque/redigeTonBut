{% extends 'base.html.twig' %}

{% block content %}
    {% if compareMode|default(false) %}
        <div class="alert alert-info mb-3">
            Comparaison active: B.U.T. {{ anneePrecedente.ordre }} (version {{ versionPrecedente.id }}) -> B.U.T. {{ annee.ordre }}.
            Le point de rapprochement est le code ressource.
        </div>
    {% endif %}
    {% if pendingPdfRessources|default([])|length > 0 %}
        <div class="alert alert-warning mb-3">
            <strong>Demandes PDF en attente ({{ pendingPdfRessources|length }})</strong>
            <ul class="mb-0 mt-2">
                {% for item in pendingPdfRessources %}
                    <li>{{ item.code }} - {{ item.libelle }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}
    {% if errorPdfRessources|default([])|length > 0 %}
        <div class="alert alert-danger mb-3">
            <strong>Erreurs de generation PDF ({{ errorPdfRessources|length }})</strong>
            <ul class="mb-0 mt-2">
                {% for item in errorPdfRessources %}
                    <li>
                        {{ item.code }} - {{ item.libelle }}
                        {% if item.errorMessage %}
                            ({{ item.errorMessage }})
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <ul class="nav nav-tabs nav-tabs-title nav-tabs-line-title responsive-tabs" id="lineTitleTabsContainer" role="tablist">
        {% for semestre in semestres %}
            <li class="nav-item" role="presentation">
                <a class="nav-link {% if (selectSemestre == null and loop.first) or (selectSemestre != null and selectSemestre
                    == semestre.id) %}active{% endif %} changeSemestreRessources" data-bs-toggle="tab"
                   data-semestre="{{ semestre.id }}"
                   href="#semestre_{{ semestre.id }}"
                   role="tab"
                   aria-selected="true">{{ semestre.libelle }}</a>
            </li>
        {% endfor %}
        {% for semestre in semestres %}
            <li class="nav-item" role="presentation">
                <a class="nav-link changeSemestreRessources" data-bs-toggle="tab"
                   data-semestre="{{ semestre.id }}"
                   href="#semestre_{{ semestre.id }}_tableau"
                   role="tab"
                   aria-selected="true">{{ semestre.libelle }} (tableau)</a>
            </li>
        {% endfor %}
    </ul>

    <div class="tab-content">
        {% for semestre in semestres %}
            <div class="tab-pane {% if (selectSemestre == null and loop.first) or (selectSemestre != null and selectSemestre
                == semestre.id) %}active{% endif %}" id="semestre_{{ semestre.id }}" role="tabpanel">
                <div class="row">
                    <div class="col-10">&nbsp;</div>
                    <div class="col-2">
                        {% if  is_granted('ROLE_EDITEUR') and user_data.version.verouilleCroise == false %}
                            {% if user_data.departement.typeStructure == 'type3' and parcours != null %}
                                <a href="{{ path('formation_apc_ressource_new', {semestre: semestre.id, parcours: parcours.id})
                                }}" class="btn
            btn-outline-primary
            btn-icon btn-icon-end
    w-100
    w-sm-auto"
                                   id="boutonAddSae">
                                    <i class="bi bi-plus-circle"></i>
                                    <span>Ajouter une ressource</span>
                                </a>
                            {% else %}
                                <a href="{{ path('formation_apc_ressource_new', {semestre:semestre.id}) }}" class="btn btn-outline-primary btn-icon
        btn-icon-end
        w-100 w-sm-auto"
                                   id="boutonAddRessource">
                                    <i class="bi bi-plus-circle"></i>
                                    <span>Ajouter une ressource</span>
                                </a>
                            {% endif %}
                        {% endif %}
                    </div>
                </div>

                <div class="row g-4 mb-4">
                    {% for ressource in ressources[semestre.ordreLmd] %}
                        {% set codeKey = (ressource.codeMatiere|trim)|upper %}
                        {% set ressourceDiff = diffBySemestre[semestre.ordreLmd][codeKey]|default(null) %}
                        {{ include('but/_cardRessource.html.twig') }}
                    {% endfor %}
                </div>

                {% if compareMode|default(false) and removedBySemestre[semestre.ordreLmd]|default([])|length > 0 %}
                    <div class="card border-danger mb-4">
                        <div class="card-header bg-danger text-white">
                            Ressources supprimées depuis la version précedente
                        </div>
                        <div class="card-body">
                            <ul class="mb-0">
                                {% for code, removed in removedBySemestre[semestre.ordreLmd] %}
                                    <li><strong>{{ removed.codeMatiere }}</strong> - {{ removed.libelle }}</li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                {% endif %}
            </div>
            <div class="tab-pane" id="semestre_{{ semestre.id }}_tableau" role="tabpanel">
                <div class="row">
                   <table class="table table-striped">
                       <thead>
                       <tr>
                           <th rowspan="2">Code</th>
                           <th rowspan="2">Libelle</th>
                           <th colspan="2" class="text-center">PN Officiel</th>
                           {% if not is_granted('ROLE_GT') and not is_granted('ROLE_IUT') %}
                           <th colspan="3" class="text-center">Préconisation ACD</th>
                           {% endif %}
                       </tr>
                       <tr>
                           <th class="text-center">Heures Totales</th>
                           <th class="text-center">Dont TP</th>
                           {% if not is_granted('ROLE_GT') and not is_granted('ROLE_IUT') %}
                           <th class="bg-warning text-center">CM</th>
                           <th class="bg-warning text-center">TD</th>
                           <th class="bg-warning text-center">TP</th>
                           {% endif %}
                       </tr>
                       </thead>
                       <tbody>
                       {% for ressource in ressources[semestre.ordreLmd]|filter(ressource => ressource
                       .ficheAdaptationLocale == false) %}
                       {% set codeKey = (ressource.codeMatiere|trim)|upper %}
                       {% set ressourceDiff = diffBySemestre[semestre.ordreLmd][codeKey]|default(null) %}
                       <tr {% if ressource.ficheAdaptationLocale == true %}class="bg-warning text-white"{% endif %}>
                           <td style="width:15%">
                               <a href="{{ path('but_fiche_ressource',
                                    {'apcRessource': ressource.id, parcours: parcours != null ? parcours.id : null, compare: compareMode|default(false) ? 1 : null }) }}" target="_blank">
                                   {{ ressource.codeMatiere }}
                               </a>
                               {% if compareMode|default(false) and ressourceDiff is not null %}
                                   {% if ressourceDiff.status == 'added' %}
                                       <span class="badge bg-success ms-1">Ajoutee</span>
                                   {% elseif ressourceDiff.status == 'changed' %}
                                       <span class="badge bg-warning text-dark ms-1">Modifiee</span>
                                   {% endif %}
                               {% endif %}
                           </td>
                           <td  style="width:35%">
                               <a href="{{ path('but_fiche_ressource',
                                    {'apcRessource': ressource.id, parcours: parcours != null ? parcours.id : null, compare: compareMode|default(false) ? 1 : null }) }}" target="_blank">
                                   {{ ressource.libelle }}
                                   {% if compareMode|default(false) and ressourceDiff is not null and ressourceDiff.changes.libelle is defined %}
                                       <br><small class="text-muted">N-1: {{ ressourceDiff.changes.libelle.old }}</small>
                                   {% endif %}
                               </a>
                           </td>
                           <td  style="width:10%" class="text-center">
                               {{ ressource.heuresTotales }}
                               {% if compareMode|default(false) and ressourceDiff is not null and ressourceDiff.changes.heuresTotales is defined %}
                                   <br><small class="text-muted">({{ ressourceDiff.changes.heuresTotales.old }})</small>
                               {% endif %}
                           </td>
                           <td  style="width:10%" class="text-center">
                               {{ ressource.tpPpn }}
                               {% if compareMode|default(false) and ressourceDiff is not null and ressourceDiff.changes.tpPpn is defined %}
                                   <br><small class="text-muted">({{ ressourceDiff.changes.tpPpn.old }})</small>
                               {% endif %}
                           </td>
                           {% if not is_granted('ROLE_GT') and not is_granted('ROLE_IUT') %}
                           <td class="bg-warning text-center"  style="width:10%">
                               {{ ressource.cmPreco }}
                               {% if compareMode|default(false) and ressourceDiff is not null and ressourceDiff.changes.cmPreco is defined %}
                                   <br><small class="text-muted">({{ ressourceDiff.changes.cmPreco.old }})</small>
                               {% endif %}
                           </td>
                           <td class="bg-warning text-center"  style="width:10%">
                               {{ ressource.tdPreco }}
                               {% if compareMode|default(false) and ressourceDiff is not null and ressourceDiff.changes.tdPreco is defined %}
                                   <br><small class="text-muted">({{ ressourceDiff.changes.tdPreco.old }})</small>
                               {% endif %}
                           </td>
                           <td class="bg-warning text-center"  style="width:10%">
                               {{ ressource.tpPreco }}
                               {% if compareMode|default(false) and ressourceDiff is not null and ressourceDiff.changes.tpPreco is defined %}
                                   <br><small class="text-muted">({{ ressourceDiff.changes.tpPreco.old }})</small>
                               {% endif %}
                           </td>
                           {% endif %}
                       </tr>
                       {% endfor %}
                       </tbody>
                   </table>
                </div>
            </div>
        {% endfor %}
    </div>
{% endblock %}

{% block header %}
    Ressources du B.U.T. {{ annee.ordre }} {% if parcours != null %} | {{ parcours.libelle }}{% endif %}
{% endblock %}

{% block breadcrumb %}
    {{ include('composants/breadcrumb.html.twig', {liens:[
        {
            href:'',
            title: 'B.U.T. ' ~annee.ordre,
        },
    ]}) }}
{% endblock %}

{% block bouton_header %}
    {% if compareMode|default(false) %}
        {% if parcours is not null %}
            <a href="{{ path('but_ressources_annee', {annee: annee.id, parcours: parcours.id}) }}" class="btn btn-sm btn-outline-secondary btn-icon btn-icon-end w-100 w-sm-auto mx-2">
                <i class="bi-arrow-left"></i>
                <span>Retour affichage</span>
            </a>
        {% else %}
            <a href="{{ path('but_ressources_annee', {annee: annee.id}) }}" class="btn btn-sm btn-outline-secondary btn-icon btn-icon-end w-100 w-sm-auto mx-2">
                <i class="bi-arrow-left"></i>
                <span>Retour affichage</span>
            </a>
        {% endif %}
    {% elseif user_data.version.previousVersion is not null %}
        {% if parcours is not null %}
            <a href="{{ path('but_ressources_annee_comparaison', {annee: annee.id, parcours: parcours.id}) }}" class="btn btn-sm btn-outline-primary btn-icon btn-icon-end w-100 w-sm-auto mx-2">
                <i class="bi-file-diff"></i>
                <span>Comparer N-1</span>
            </a>
        {% else %}
            <a href="{{ path('but_ressources_annee_comparaison', {annee: annee.id}) }}" class="btn btn-sm btn-outline-primary btn-icon btn-icon-end w-100 w-sm-auto mx-2">
                <i class="bi-file-diff"></i>
                <span>Comparer N-1</span>
            </a>
        {% endif %}
    {% endif %}
{% endblock %}

