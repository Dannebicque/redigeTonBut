<div class="col-md-4 col-sm-12">
    <div class="card {% if ressource.ficheAdaptationLocale == true %}bg-warning text-white{% endif %}">
        <div class="card-body">
            <div class="card-title">
                <h4>{{ ressource.display }}</h4>
                <div>
                    {% if ressource.isRessourceIA %}
                    <span class="badge bg-info">IA</span>
                    {% endif %}
                    {% if ressource.isRessourceTEDS %}
                        <span class="badge bg-info">TEDS</span>
                    {% endif %}
                    {% if ressource.isRessourceExpression %}
                        <span class="badge bg-info">Expression</span>
                    {% endif %}
                    {% if ressource.isRessourceLve %}
                        <span class="badge bg-info">LVE</span>
                    {% endif %}

                    {% if ressource.isRessourcePpp %}
                        <span class="badge bg-info">PPP</span>
                    {% endif %}
                </div>
            </div>
            {% set pdfStatusData = pdfStatusByRessource[ressource.id]|default({'status': 'absent', 'errorMessage': null, 'lastGeneratedAt': null}) %}
            {% if compareMode|default(false) and ressourceDiff is not null %}
                {% if ressourceDiff.status == 'added' %}
                    <span class="badge bg-success mb-2">Ajoutée depuis N-1</span>
                {% elseif ressourceDiff.status == 'changed' %}
                    <span class="badge bg-warning text-dark mb-2">Modifiée</span>
                {% else %}
                    <span class="badge bg-secondary mb-2">Identique</span>
                {% endif %}
            {% endif %}
            <p class="card-subtitle mb-3 text-alternate">{{ ressource.motsCles }}</p>
            <p>
                {% for competence in ressource.apcRessourceCompetences %}
                    <span class="badge badge-{{ competence.competence.couleur }}">
                        {{ competence.competence.nomCourt }}</span>
                {% endfor %}

            </p>
            <h5>Heures ressources</h5>
            <table class="table table-bordered">
                <thead>
                <tr>
                    <th style="width:50%">Heures totales</th>
                    <th style="width:50%">Dont TP</th>

                </tr>
                </thead>
                <tbody>
                <tr>
                    <td>{{ ressource.heuresTotales }}</td>
                    <td>{{ ressource.tpPpn }}</td>
                </tr>
                </tbody>
            </table>
            {% if compareMode|default(false) and ressourceDiff is not null and ressourceDiff.status == 'changed' and ressourceDiff.changes|length > 0 %}
                <div class="small text-muted mb-2">
                    {% if ressourceDiff.changes.libelle is defined %}
                        <div><strong>Libelle:</strong> {{ ressourceDiff.changes.libelle.old }} -> {{ ressourceDiff.changes.libelle.new }}</div>
                    {% endif %}
                    {% if ressourceDiff.changes.heuresTotales is defined %}
                        <div><strong>Heures:</strong> {{ ressourceDiff.changes.heuresTotales.old }} -> {{ ressourceDiff.changes.heuresTotales.new }}</div>
                    {% endif %}
                    {% if ressourceDiff.changes.tpPpn is defined %}
                        <div><strong>TP PPN:</strong> {{ ressourceDiff.changes.tpPpn.old }} -> {{ ressourceDiff.changes.tpPpn.new }}</div>
                    {% endif %}
                    {% if ressourceDiff.changes.cmPreco is defined %}
                        <div><strong>CM:</strong> {{ ressourceDiff.changes.cmPreco.old }} -> {{ ressourceDiff.changes.cmPreco.new }}</div>
                    {% endif %}
                    {% if ressourceDiff.changes.tdPreco is defined %}
                        <div><strong>TD:</strong> {{ ressourceDiff.changes.tdPreco.old }} -> {{ ressourceDiff.changes.tdPreco.new }}</div>
                    {% endif %}
                    {% if ressourceDiff.changes.tpPreco is defined %}
                        <div><strong>TP:</strong> {{ ressourceDiff.changes.tpPreco.old }} -> {{ ressourceDiff.changes.tpPreco.new }}</div>
                    {% endif %}
                </div>
            {% endif %}
            <p>
                {% set parcoursPdfId = parcours is defined and parcours is not null ? parcours.id : null %}
                {% if user_data.departement.typeStructure == 'type3' or annee.ordre >= 2 %}
                    {% for parcoursItem in ressource.apcRessourceParcours %}
                        <span class="badge badge-parcours-{{ parcoursItem.parcours.couleur }}">
                            {{ parcoursItem.parcours.libelle }}
                        </span>
                        {% if parcoursPdfId is null %}
                            {% set parcoursPdfId = parcoursItem.parcours.id %}
                        {% endif %}
                    {% else %}
                        <span class="badge bg-warning">
                            Pas de parcours associé
                    </span>
                    {% endfor %}
                {% else %}
                    <span class="badge bg-success">
                            Tous les parcours
                    </span>
                {% endif %}
            </p>
        </div>
        <div class="card-footer">
            <div class="col-12 d-flex align-items-center justify-content-md-end mb-2">
                {% if pdfStatusData.status == 'present' %}
                    <span class="badge bg-success me-2">PDF disponible</span>
                {% elseif pdfStatusData.status == 'pending' %}
                    <span class="badge bg-warning text-dark me-2">Generation en attente</span>
                {% elseif pdfStatusData.status == 'error' %}
                    <span class="badge bg-danger me-2" title="{{ pdfStatusData.errorMessage|default('Erreur de generation PDF') }}">Erreur PDF</span>
                {% else %}
                    <span class="badge bg-secondary me-2">PDF non genere</span>
                {% endif %}
                {% if pdfStatusData.lastGeneratedAt is not null %}
                    <small class="text-muted me-2">{{ pdfStatusData.lastGeneratedAt|date('d/m/Y H:i') }}</small>
                {% endif %}
                <a href="{{ path('pdf_show',
                    {sourceType: 'ressource', 'sourceId': ressource.id, parcours: parcoursPdfId, documentKey: 'fiche' }) }}"
                   class="btn btn-block btn-sm btn-icon btn-icon-start btn-outline-primary ms-1"
                   target="_blank"
                >
                    <i class="bi-print"></i>
                    <span class="d-none d-xxl-inline-block">Afficher / generer le PDF</span>
                </a>
                <a href="{{ path('pdf_show',
                    {sourceType: 'ressource', 'sourceId': ressource.id, parcours: parcoursPdfId, documentKey: 'fiche', force: 1 }) }}"
                   class="btn btn-block btn-sm btn-icon btn-icon-start btn-outline-warning ms-1"
                   target="_blank"
                >
                    <i class="bi-arrow-repeat"></i>
                    <span class="d-none d-xxl-inline-block">Forcer la mise a jour</span>
                </a>
            </div>

            <div class="col-12 d-flex align-items-center justify-content-md-end mb-2">
                <a href="{{ path('but_fiche_ressource',
                    {'apcRessource': ressource.id, parcours: parcours != null ? parcours.id : null, compare: compareMode|default(false) ? 1 : null }) }}"
                   class="btn btn-block btn-sm btn-icon btn-icon-start btn-outline-primary ms-1"
                   target="_blank"
                >
                    <i class="bi-info-circle"></i>
                    <span class="d-none d-xxl-inline-block">Voir la fiche ressource</span>
                </a>
            </div>
            {% if is_granted('ROLE_EDITEUR') %}
                <div class="col-12 d-flex align-items-center justify-content-md-end">
                    {% if user_data.version.pnVerouille == false %}
                        {% if user_data.version.verouilleCroise == false %}
                            <a href="{{ path('formation_apc_ressource_duplicate',
                                {'id': ressource.id, parcours: parcours != null ? parcours.id : null }) }}" class="btn btn-sm btn-icon btn-icon-start btn-outline-info ms-1"
                               type="button">
                                <i class="bi-files"></i>
                                <span class="d-none d-xxl-inline-block">Dupliquer</span>
                            </a>
                        {% endif %}
                        <a href="{{ path('formation_apc_ressource_edit',
                            {'id': ressource.id, parcours: parcours != null ? parcours.id : null }) }}" class="btn btn-sm
                    btn-icon btn-icon-start ms-1 {% if ressource.ficheAdaptationLocale == true %} btn-outline-dark text-white{% else %} btn-outline-warning{% endif %}" type="button">
                            <i class="bi-pencil-square"></i>
                            <span class="d-none d-xxl-inline-block">Modifier</span>
                        </a>
                        {% if is_granted('ROLE_PACD') and user_data.version.verouilleCroise == false %}
                            {{ include('form/_delete_form.html.twig', {path: path('formation_apc_ressource_delete',
                                {id: ressource.id, }), id: ressource.id}) }}
                        {% endif %}
                    {% endif %}

                </div>
            {% endif %}
        </div>
    </div>
</div>
