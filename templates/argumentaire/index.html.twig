{% extends 'base.html.twig' %}

{% block header %}Argumentaire CPN{% endblock %}

{% block content %}
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <h1 class="mb-3">Référentiel de formation - Argumentaire CPN : <strong>{{ version.departement.sigle }}</strong></h1>
                <p class="text-muted">
                    Ce document a pour objectif d’éclairer la CCN sur les modifications proposées par les
                    spécialités.<br>
                    Il constitue une première aide à la lecture des évolutions envisagées, sans préjuger des autres
                    points que la CCN pourrait souhaiter examiner ou discuter.
                </p>

                <div class="d-flex justify-content-end mb-4">
                    <a href="{{ path('pdf_show', {sourceType: 'argumentaire', sourceId: version.id, documentKey: 'fiche'}) }}"
                       class="btn btn-outline-primary btn-icon btn-icon-start"
                    >
                        <i class="bi-print"></i>
                        <span>Générer le PDF de l'argumentaire</span>
                    </a>
                </div>

                <form method="post"
                      data-controller="argumentaire-autosave"
                      data-argumentaire-autosave-url-value="{{ path('argumentaire_autosave', {version: version.id}) }}"
                      data-argumentaire-autosave-payload-value="{{ argumentairePayload|default({})|json_encode|e('html_attr') }}"
                      data-action="focusout->argumentaire-autosave#saveField change->argumentaire-autosave#saveField"
                >
                    <div class="alert alert-light border d-flex justify-content-between align-items-center mb-3" role="status">
                        <span>
                            Derniere sauvegarde :
                            <strong data-argumentaire-autosave-target="updatedAt">
                                {% if argumentaireUpdatedAt %}
                                    {{ argumentaireUpdatedAt|date('d/m/Y H:i:s') }}
                                {% else %}
                                    Aucune
                                {% endif %}
                            </strong>
                        </span>
                        <span class="badge bg-secondary" data-argumentaire-autosave-target="status">Brouillon</span>
                    </div>

                    <div class="alert alert-info mb-4">
                        Les commentaires sont sauvegardées automatiquement
                    </div>

                    <section class="mb-5">
                        <h2 class="h4 border-bottom pb-2">Questions générales</h2>
                        <div class="mb-3">
                            <label for="presentation_evolutions" class="form-label font-weight-bold">
                                Pouvez-vous présenter en quelques lignes les éléments qui ont conduit aux évolutions
                                envisagées : bilan en GT, diagnostic, modification des référentiels de compétences etc ?
                            </label>
                            <textarea id="presentation_evolutions" name="presentation_evolutions" class="form-control"
                                      rows="5"></textarea>
                        </div>
                    </section>

                    <section class="mb-5">
                        <h2 class="h4 border-bottom pb-2">Tableau de structure pour le BUT</h2>
                        <div class="alert alert-info">
                            <strong>Rappel de la lettre de cadrage :</strong><br>
                            Vérifier l’équilibre des volumes horaires et de la charge de travail entre les semestres et
                            années de la formation pour permettre la réussite de tous les étudiants en particulier en
                            première année.
                        </div>

                        <div class="mb-4">
                            <p class="font-weight-bold">Modification des équilibres des volumes horaires par semestre
                                ?</p>
                        </div>

                        <div class="table-responsive mb-4">
                            <table class="table table-bordered align-middle">
                                <thead class="table-light text-center">
                                <tr>
                                    <th>Semestre</th>
                                    <th>2022</th>
                                    <th>2027</th>
                                    <th>Diff.</th>
                                    <th>Commentaires/explications</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for i in 1..6 %}
                                    <tr>
                                        <td class="text-center font-weight-bold">S{{ i }}</td>
                                        <td>{{ structurePrevious[i].nbHeuresCoursProjet }} (dont ptut
                                            : {{ structurePrevious[i].nbHeuresProjet }})
                                        </td>
                                        <td>{{ structureCurrent[i].nbHeuresCoursProjet }} (dont ptut
                                            : {{ structureCurrent[i].nbHeuresProjet }})
                                        </td>
                                        <td>
                                            {% if structurePrevious[i].nbHeuresCoursProjet < structureCurrent[i].nbHeuresCoursProjet %}
                                                {% set identique = false %}
                                                <span class="badge bg-danger">+ {{ structureCurrent[i].nbHeuresCoursProjet - structurePrevious[i].nbHeuresCoursProjet }}</span>
                                            {% elseif structurePrevious[i].nbHeuresCoursProjet > structureCurrent[i].nbHeuresCoursProjet %}
                                                {% set identique = false %}
                                                <span class="badge bg-danger">- {{ structurePrevious[i].nbHeuresCoursProjet - structureCurrent[i].nbHeuresCoursProjet }}</span>
                                            {% else %}
                                                {% set identique = true %}
                                                <span class="badge bg-success">Identique</span>
                                            {% endif %}

                                        </td>
                                        <td>
                                            {% if identique == false %}
                                                <textarea class="form-control" name="vh_com_s{{ i }}"
                                                          rows="1"></textarea>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>

                        <div class="mb-4">
                            <p class="font-weight-bold">Modification des équilibres volumes horaires des SAE/volumes
                                horaires des ressources ?</p>
                        </div>

                        <div class="table-responsive mb-4">
                            <table class="table table-bordered align-middle text-center">
                                <thead class="table-light">
                                <tr>
                                    <th rowspan="2"></th>
                                    <th colspan="2">2022</th>
                                    <th colspan="2">2027</th>
                                    <th colspan="2">Diff.</th>
                                    <th rowspan="2">Commentaires/explications</th>
                                </tr>
                                <tr>
                                    <th>SAE/Portfolio</th>
                                    <th>Ressources</th>
                                    <th>SAE/Portfolio</th>
                                    <th>Ressources</th>
                                    <th>SAE/Portfolio</th>
                                    <th>Ressources</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for i in 1..6 %}
                                    <tr>
                                        <td class="font-weight-bold">S{{ i }}</td>
                                        <td>
                                            {{ structurePrevious[i].nbHeuresEnseignementSaeLocale }}
                                        </td>
                                        <td>{{ structurePrevious[i].nbHeuresEnseignementRessourceNational +  structurePrevious[i].nbHeuresEnseignementRessourceLocale }}
                                            (dont AL {{ structurePrevious[i].nbHeuresEnseignementRessourceLocale }})
                                        </td>
                                        <td>{{ structureCurrent[i].nbHeuresEnseignementSaeLocale }}</td>
                                        <td>{{ structureCurrent[i].nbHeuresEnseignementRessourceNational +  structureCurrent[i].nbHeuresEnseignementRessourceLocale }}
                                            (dont AL {{ structureCurrent[i].nbHeuresEnseignementRessourceLocale }})
                                        </td>

                                        <td>
                                            {% if structurePrevious[i].nbHeuresEnseignementSaeLocale < structureCurrent[i].nbHeuresEnseignementSaeLocale %}
                                                {% set identique = false %}
                                                <span class="badge bg-danger">+ {{ structureCurrent[i].nbHeuresEnseignementSaeLocale - structurePrevious[i].nbHeuresEnseignementSaeLocale }}</span>
                                            {% elseif structurePrevious[i].nbHeuresEnseignementSaeLocale > structureCurrent[i].nbHeuresEnseignementSaeLocale %}
                                                {% set identique = false %}
                                                <span class="badge bg-danger">- {{ structurePrevious[i].nbHeuresEnseignementSaeLocale - structureCurrent[i].nbHeuresEnseignementSaeLocale }}</span>
                                            {% else %}
                                                {% set identique = true %}
                                                <span class="badge bg-success">Identique</span>
                                            {% endif %}

                                        </td>
                                        <td>
                                            {% if structurePrevious[i].nbHeuresEnseignementRessourceNational +  structurePrevious[i].nbHeuresEnseignementRessourceLocale < structureCurrent[i].nbHeuresEnseignementRessourceNational +  structureCurrent[i].nbHeuresEnseignementRessourceLocale %}
                                                {% set identique2 = false %}
                                                <span class="badge bg-danger">+ {{ structurePrevious[i].nbHeuresEnseignementRessourceNational +  structurePrevious[i].nbHeuresEnseignementRessourceLocale - structureCurrent[i].nbHeuresEnseignementRessourceNational -  structureCurrent[i].nbHeuresEnseignementRessourceLocale }}</span>
                                            {% elseif structurePrevious[i].nbHeuresEnseignementRessourceNational +  structurePrevious[i].nbHeuresEnseignementRessourceLocale > structureCurrent[i].nbHeuresEnseignementRessourceNational +  structureCurrent[i].nbHeuresEnseignementRessourceLocale %}
                                                {% set identique2 = false %}
                                                <span class="badge bg-danger">- {{ structurePrevious[i].nbHeuresEnseignementRessourceNational +  structurePrevious[i].nbHeuresEnseignementRessourceLocale - structureCurrent[i].nbHeuresEnseignementRessourceNational -  structureCurrent[i].nbHeuresEnseignementRessourceLocale }}</span>
                                            {% else %}
                                                {% set identique2 = true %}
                                                <span class="badge bg-success">Identique</span>
                                            {% endif %}
                                        </td>


                                        <td>
                                            {% if identique == false or identique2 == false %}
                                                <textarea class="form-control" name="sae_res_com_s{{ i }}"
                                                          rows="1"></textarea>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>

                        <div class="mb-4">
                            <p class="font-weight-bold">Modifications des volumes de l’adaptation locale ?</p>
                        </div>

                        <div class="table-responsive mb-4">
                            <table class="table table-bordered align-middle text-center">
                                <thead class="table-light">
                                <tr>
                                    <th rowspan="2"></th>
                                    <th colspan="2">2022</th>
                                    <th colspan="2">2027</th>
                                    <th colspan="2">Diff.</th>
                                    <th rowspan="2">Commentaires/explications</th>
                                </tr>
                                <tr>
                                    <th>SAE/Portfolio</th>
                                    <th>Ressources</th>
                                    <th>SAE/Portfolio</th>
                                    <th>Ressources</th>
                                    <th>SAE/Portfolio</th>
                                    <th>Ressources</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for i in 1..6 %}
                                    <tr>
                                        <td class="font-weight-bold">S{{ i }}</td>
                                        <td>
                                            {{ structurePrevious[i].nbHeuresEnseignementSaeLocale }}
                                        </td>
                                        <td>
                                            {{ structurePrevious[i].nbHeuresEnseignementRessourceLocale }}
                                        </td>
                                        <td>
                                            {{ structureCurrent[i].nbHeuresEnseignementSaeLocale }}
                                        </td>
                                        <td>
                                            {{ structureCurrent[i].nbHeuresEnseignementRessourceLocale }}
                                        </td>
                                        <td>
                                            {% if structurePrevious[i].nbHeuresEnseignementSaeLocale < structureCurrent[i].nbHeuresEnseignementSaeLocale %}
                                                {% set identique = false %}
                                                <span class="badge bg-danger">+ {{ structureCurrent[i].nbHeuresEnseignementSaeLocale - structurePrevious[i].nbHeuresEnseignementSaeLocale }}</span>
                                            {% elseif structurePrevious[i].nbHeuresEnseignementSaeLocale > structureCurrent[i].nbHeuresEnseignementSaeLocale %}
                                                {% set identique = false %}
                                                <span class="badge bg-danger">- {{ structurePrevious[i].nbHeuresEnseignementSaeLocale - structureCurrent[i].nbHeuresEnseignementSaeLocale }}</span>
                                            {% else %}
                                                {% set identique = true %}
                                                <span class="badge bg-success">Identique</span>
                                            {% endif %}

                                        </td>
                                        <td>
                                            {% if structurePrevious[i].nbHeuresEnseignementRessourceLocale < structureCurrent[i].nbHeuresEnseignementRessourceLocale %}
                                                {% set identique2 = false %}
                                                <span class="badge bg-danger">+ {{ structurePrevious[i].nbHeuresEnseignementRessourceLocale - structureCurrent[i].nbHeuresEnseignementRessourceLocale }}</span>
                                            {% elseif structurePrevious[i].nbHeuresEnseignementRessourceLocale > structureCurrent[i].nbHeuresEnseignementRessourceLocale %}
                                                {% set identique2 = false %}
                                                <span class="badge bg-danger">- {{ structurePrevious[i].nbHeuresEnseignementRessourceLocale - structureCurrent[i].nbHeuresEnseignementRessourceLocale }}</span>
                                            {% else %}
                                                {% set identique2 = true %}
                                                <span class="badge bg-success">Identique</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if identique == false or identique2 == false %}
                                                <textarea class="form-control" name="al_com_s{{ i }}"
                                                          rows="1"></textarea>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>

                        <div class="mb-4">
                            <p class="font-weight-bold">Modification des autres éléments du tableau : TP, heures en autonomie ?</p>
                        </div>
                        <div class="table-responsive mb-4">
                            <table class="table table-bordered align-middle text-center">
                                <thead class="table-light">
                                <tr>
                                    <th rowspan="2"></th>
                                    <th colspan="3">TP vol total</th>
                                    <th colspan="3">Heures d'autonomie</th>
                                    <th rowspan="2">Commentaires/explications</th>
                                </tr>
                                <tr>
                                    <th>2022</th>
                                    <th>2027</th>
                                    <th>Diff.</th>
                                    <th>2022</th>
                                    <th>2027</th>
                                    <th>Diff.</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for i in 1..6 %}
                                    <tr>
                                        <td class="font-weight-bold">S{{ i }}</td>
                                        <td>
                                            {{ structurePrevious[i].nbHeuresTpNational + structurePrevious[i].nbHeuresTpLocale }} (dont AL {{ structurePrevious[i].nbHeuresTpLocale }})
                                        </td>
                                        <td>
                                            {{ structureCurrent[i].nbHeuresTpNational + structureCurrent[i].nbHeuresTpLocale }} (dont AL {{ structureCurrent[i].nbHeuresTpLocale }})
                                        </td>
                                        <td>
                                            {% set diffTp = (structureCurrent[i].nbHeuresTpNational + structureCurrent[i].nbHeuresTpLocale) - (structurePrevious[i].nbHeuresTpNational + structurePrevious[i].nbHeuresTpLocale) %}
                                            {% set diffAuton = structureCurrent[i].nbHeuresProjet - structurePrevious[i].nbHeuresProjet %}

                                            {% if diffTp > 0 %}
                                                <span class="badge bg-danger">TP: +{{ diffTp }}</span>
                                            {% elseif diffTp < 0 %}
                                                <span class="badge bg-danger">TP: {{ diffTp }}</span>
                                            {% else %}
                                                <span class="badge bg-success">TP: Identique</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {{ structurePrevious[i].nbHeuresProjet }}
                                        </td>
                                        <td>
                                            {{ structureCurrent[i].nbHeuresProjet }}
                                        </td>
                                        <td>
                                            {% if diffAuton > 0 %}
                                                <span class="badge bg-danger">Auton: +{{ diffAuton }}</span>
                                            {% elseif diffAuton < 0 %}
                                                <span class="badge bg-danger">Auton: {{ diffAuton }}</span>
                                                {% else %}
                                                    <span class="badge bg-success">Identique</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if diffTp != 0 or diffAuton != 0 %}
                                                <textarea class="form-control" name="tp_auton_com_s{{ i }}" rows="1"></textarea>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </section>

                    <section class="mb-5 text-center">
                        <h2 class="h4 border-bottom pb-2">Stages</h2>
                        <div class="mb-4">
                            <p class="font-weight-bold">Modifications des durées et du positionnement des stages
                                ?</p>
                        </div>

                        <div class="table-responsive mb-4 text-start">
                            <table class="table table-bordered align-middle text-center">
                                <thead class="table-light">
                                <tr>
                                    <th rowspan="2"></th>
                                    <th colspan="3">Positionnement (semestre)</th>
                                    <th colspan="3">Durées en semaines</th>
                                    <th rowspan="2">Commentaires/explications</th>
                                </tr>
                                <tr>
                                    <th>2022</th>
                                    <th>2027</th>
                                    <th>Diff.</th>
                                    <th>2022</th>
                                    <th>2027</th>
                                    <th>Diff.</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% set totalPreviousMin = 0 %}
                                {% set totalPreviousMax = 0 %}
                                {% set totalCurrentMin = 0 %}
                                {% set totalCurrentMax = 0 %}
                                {% for i in 1..6 %}
                                    {% set totalPreviousMin = totalPreviousMin + structurePrevious[i].nbSemainesStageMin %}
                                    {% set totalPreviousMax = totalPreviousMax + structurePrevious[i].nbSemainesStageMax %}
                                    {% set totalCurrentMin = totalCurrentMin + structureCurrent[i].nbSemainesStageMin %}
                                    {% set totalCurrentMax = totalCurrentMax + structureCurrent[i].nbSemainesStageMax %}
                                    <tr>
                                        <td class="font-weight-bold">S{{ i }}</td>
                                        <td>
                                           {% if structurePrevious[i].nbSemainesStageMax > 0 %}
                                            X
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if structureCurrent[i].nbSemainesStageMax > 0 %}
                                                X
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if structurePrevious[i].nbSemainesStageMax > 0 and structureCurrent[i].nbSemainesStageMax > 0 %}
                                                {% set diff = structureCurrent[i].nbSemainesStageMax - structurePrevious[i].nbSemainesStageMax %}
                                                {% if diff > 0 %}
                                                    <span class="badge bg-danger">+{{ diff }}</span>
                                                {% elseif diff < 0 %}
                                                    <span class="badge bg-danger">{{ diff }}</span>
                                                {% else %}
                                                    <span class="badge bg-success">Identique</span>
                                                {% endif %}
                                                {% endif %}
                                        </td>
                                        <td>
                                            {% if structurePrevious[i].nbSemainesStageMax > 0 %}
                                            {{ structurePrevious[i].nbSemainesStageMin }} (min) - {{ structurePrevious[i].nbSemainesStageMax }} (max)
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if structurePrevious[i].nbSemainesStageMax > 0 %}
                                            {{ structureCurrent[i].nbSemainesStageMin }} (min) - {{ structureCurrent[i].nbSemainesStageMax }} (max)
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% set previous = structurePrevious[i].nbSemainesStageMin~'_'~structurePrevious[i].nbSemainesStageMax %}
                                            {% set current = structureCurrent[i].nbSemainesStageMin~'_'~structureCurrent[i].nbSemainesStageMax %}

                                            {% if structurePrevious[i].nbSemainesStageMax > 0 or structureCurrent[i].nbSemainesStageMax > 0 %}

                                                {% if previous != current %}
                                                    <span class="badge bg-danger">Modification</span>
                                                {% else %}
                                                    <span class="badge bg-success">Identique</span>
                                                {% endif %}
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if previous != current %}
                                            <textarea class="form-control" name="stage_com_s{{ i }}"
                                                      rows="1"></textarea>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                                <tr class="table-light font-weight-bold">
                                    <td>Total</td>
                                    <td colspan="3"></td>
                                    <td>{{ totalPreviousMin }} - {{ totalPreviousMax }}</td>
                                    <td>{{ totalCurrentMin }} - {{ totalCurrentMax }}</td>
                                    <td></td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </section>

                    <section class="mb-5">
                        <h2 class="h4 border-bottom pb-2">Alternance</h2>
                        <div class="mb-4">
                            <p class="font-weight-bold">Modifications de la réduction de l'alternance ?</p>
                        </div>

                        <div class="table-responsive mb-4">
                            <table class="table table-bordered align-middle text-center">
                                <thead class="table-light">
                                <tr>
                                    <th></th>
                                    <th>2022</th>
                                    <th>2027</th>
                                    <th>Diff.</th>
                                    <th>Commentaires/explications</th>
                                </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td class="font-weight-bold">BUT 1</td>
                                        <td>
                                            {{ previousVersion.altBut1 }} %
                                        </td>
                                        <td>{{ version.altBut1 }} %</td>
                                        <td>{% if previousVersion.altBut1 != version.altBut1  %}
                                        {% set modif = true %}
                                                <span class="badge bg-danger">Modification</span>
                                            {% else %}
                                                {% set modif = false %}
                                                <span class="badge bg-success">Identique</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if modif == true %}<textarea class="form-control" name="alt_com_b1" rows="1"></textarea>
                                            {% endif %}
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="font-weight-bold">BUT 2</td>
                                        <td>
                                            {{ previousVersion.altBut2 }} %
                                        </td>
                                        <td>{{ version.altBut2 }} %</td>
                                        <td>{% if previousVersion.altBut2 != version.altBut2  %}
                                        {% set modif = true %}
                                                <span class="badge bg-danger">Modification</span>
                                            {% else %}
                                                {% set modif = false %}
                                                <span class="badge bg-success">Identique</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if modif == true %}<textarea class="form-control" name="alt_com_b2" rows="1"></textarea>
                                            {% endif %}
                                        </td>
                                    </tr>
                                    <tr>
                                        <td class="font-weight-bold">BUT 3</td>
                                        <td>
                                            {{ previousVersion.altBut3 }} %
                                        </td>
                                        <td>{{ version.altBut3 }} %</td>
                                        <td>{% if previousVersion.altBut3 != version.altBut3  %}
                                        {% set modif = true %}
                                                <span class="badge bg-danger">Modification</span>
                                            {% else %}
                                                {% set modif = false %}
                                                <span class="badge bg-success">Identique</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if modif == true %}<textarea class="form-control" name="alt_com_b3" rows="1"></textarea>
                                            {% endif %}
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </section>

                    <section class="mb-5">
                        <h2 class="h4 border-bottom pb-2">Les SAÉ</h2>
                        <div class="alert alert-info">
                            <strong>Rappel de la lettre de cadrage :</strong><br>
                            Les SAÉ de première année mono-compétence, de manière à faciliter l’identification de la compétence par les étudiants. Cependant à partir de S2, les spécialités peuvent ajouter une
                            SAÉ pluri compétences.<br>
                            Veiller à ce que le nombre de SAÉ soit soutenable, du point de vue de la charge de travail, aussi bien pour les étudiants que pour les personnes enseignantes (travaux de groupe, travaux individuels).
                        </div>

                        <h3 class="h5 mb-3">Organisation des SAÉ</h3>
                        <p class="font-weight-bold">Modification du nombre de SAÉ, SAÉ monocompétence, SAE pluricompétences par semestre ?</p>
                        <div class="table-responsive mb-4">
                            <table class="table table-bordered align-middle text-center">
                                <thead class="table-light">
                                <tr>
                                    <th rowspan="2"></th>
                                    <th colspan="3">Nbre de compétences</th>
                                    <th colspan="3">Nbre total de SAÉ Hors stage</th>
                                    <th colspan="3">Nbre de SAE mono-compétence Hors stage</th>
                                    <th colspan="3">Nbre de SAÉ pluri-compétences Hors stage</th>
                                    <th rowspan="2">Commentaires/explications</th>
                                </tr>
                                <tr>
                                    <th>2022</th>
                                    <th>2027</th>
                                    <th>Diff.</th>
                                    <th>2022</th>
                                    <th>2027</th>
                                    <th>Diff.</th>
                                    <th>2022</th>
                                    <th>2027</th>
                                    <th>Diff.</th>
                                    <th>2022</th>
                                    <th>2027</th>
                                    <th>Diff.</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for i in 1..6 %}
                                    <tr>
                                        <td class="font-weight-bold">S{{ i }}</td>
                                        <td>
                                            {{ structurePrevious[i].structureSemestre.nbCompetences }}
                                        </td>
                                        <td>
                                            {{ structureCurrent[i].structureSemestre.nbCompetences }}
                                        </td>
                                        <td>
                                            {% if structurePrevious[i].structureSemestre.nbCompetences != structureCurrent[i].structureSemestre.nbCompetences %}
                                                <span class="badge bg-danger">{{ structureCurrent[i].structureSemestre.nbCompetences - structurePrevious[i].structureSemestre.nbCompetences }}</span>
                                            {% else %}
                                                <span class="badge bg-success">Identique</span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {{ structurePrevious[i].structureSemestre.nbSaes }}
                                        </td>
                                        <td>
                                            {{ structureCurrent[i].structureSemestre.nbSaes }}
                                        </td>
                                        <td>
                                            {% if structurePrevious[i].structureSemestre.nbSaes != structureCurrent[i].structureSemestre.nbSaes %}
                                                <span class="badge bg-danger">{{ structureCurrent[i].structureSemestre.nbSaes - structurePrevious[i].structureSemestre.nbSaes }}</span>
                                            {% else %}
                                                <span class="badge bg-success">Identique</span>
                                            {% endif %}
                                        </td>

                                        <td>
                                            {{ structurePrevious[i].structureSemestre.nbSaesMonoCompetence }}
                                        </td>
                                        <td>
                                            {{ structureCurrent[i].structureSemestre.nbSaesMonoCompetence }}
                                        </td>
                                        <td>
                                            {% if structurePrevious[i].structureSemestre.nbSaesMonoCompetence != structureCurrent[i].structureSemestre.nbSaesMonoCompetence %}
                                                <span class="badge bg-danger">{{ structureCurrent[i].structureSemestre.nbSaesMonoCompetence - structurePrevious[i].structureSemestre.nbSaesMonoCompetence }}</span>
                                            {% else %}
                                                <span class="badge bg-success">Identique</span>
                                            {% endif %}
                                        </td>

                                        <td>
                                            {{ structurePrevious[i].structureSemestre.nbSaesMultiCompetence }}
                                        </td>
                                        <td>
                                            {{ structureCurrent[i].structureSemestre.nbSaesMultiCompetence }}
                                        </td>
                                        <td>
                                            {% if structurePrevious[i].structureSemestre.nbSaesMultiCompetence != structureCurrent[i].structureSemestre.nbSaesMultiCompetence %}
                                                <span class="badge bg-danger">{{ structureCurrent[i].structureSemestre.nbSaesMultiCompetence - structurePrevious[i].structureSemestre.nbSaesMultiCompetence }}</span>
                                            {% else %}
                                                <span class="badge bg-success">Identique</span>
                                            {% endif %}
                                        </td>

                                        <td>
                                            <textarea class="form-control" name="sae_org_com_s{{ i }}"
                                                      rows="1"></textarea>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>

                        <p class="font-weight-bold">Avez-vous créé ou modifié des fiches SAE ? Dans quel objectif ?</p>
                        <div class="table-responsive mb-4">
                            <table class="table table-bordered align-middle text-center">
                                <thead class="table-light">
                                <tr>
                                    <th></th>
                                    <th>Numéro des SAE</th>
                                    <th>Commentaires/explications</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for i in 1..6 %}
                                    <tr>
                                        <td class="font-weight-bold">S{{ i }}</td>
                                        <td><input type="text" class="form-control" name="sae_fiche_nb_s{{ i }}"></td>
                                        <td><textarea class="form-control" name="sae_fiche_com_s{{ i }}"
                                                      rows="1"></textarea></td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </section>

                    <section class="mb-5">
                        <h2 class="h4 border-bottom pb-2">Les ressources</h2>
                        <div class="alert alert-info">
                            <strong>Rappel de la lettre de cadrage :</strong><br>
                            « Veiller à attribuer aux ressources des volumes suffisants pour permettre l’apprentissage
                            et l’évaluation continue des étudiants.<br>
                            Veiller à maintenir le volume horaire minimal pour les ressources transversales :<br>
                            - Pour les langues et l’expression écrite et orale : a minima 200h (hors heures d’adaptation
                            locale)<br>
                            - Pour le PPP sur les 5 semestres, a minima : 10h par semestre «
                        </div>

                        <h3 class="h5 mb-3">Volumes horaires hors adaptation locale</h3>
                        <p class="font-weight-bold">Quels volumes horaires avez-vous modifiés ?</p>
                        <div class="table-responsive mb-4">
                            <table class="table table-bordered align-middle text-center">
                                <thead class="table-light">
                                <tr>
                                    <th></th>
                                    <th>Numéro des ressources</th>
                                    <th>Commentaires/explications</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for i in 1..6 %}
                                    <tr>
                                        <td class="font-weight-bold">S{{ i }}</td>
                                        <td><input type="text" class="form-control" name="res_vh_nb_s{{ i }}"></td>
                                        <td><textarea class="form-control" name="res_vh_com_s{{ i }}"
                                                      rows="1"></textarea></td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>

                        <div class="mb-4">
                            <p class="font-weight-bold">Dans quel objectif ? Comment ?</p>
                            <textarea name="res_objectif" class="form-control" rows="3"></textarea>
                        </div>

                        <h3 class="h5 mb-3">PPP</h3>
                        <div class="table-responsive mb-4">
                            <table class="table table-bordered align-middle text-center">
                                <thead class="table-light">
                                <tr>
                                    <th>PPP</th>
                                    <th>Volume horaire (hors adaptation locale)</th>
                                    <th>Commentaires/explications</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for i in 1..6 %}
                                    <tr>
                                        <td class="font-weight-bold">S{{ i }}</td>
                                        <td><input type="text" class="form-control" name="ppp_vh_s{{ i }}"></td>
                                        <td><textarea class="form-control" name="ppp_com_s{{ i }}" rows="1"></textarea>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>

                        <h3 class="h5 mb-3">Ressource « Utilisation éthique et responsable de l’Intelligence
                            Artificielle (IA) » et ressource sur les problématiques TEDS</h3>
                        <div class="mb-4">
                            <p class="font-weight-bold">Comment avez-vous inséré ces éléments dans le référentiel de
                                formation ?</p>
                            <div class="table-responsive">
                                <table class="table table-bordered align-middle text-center">
                                    <thead class="table-light">
                                    <tr>
                                        <th>Volume horaire (hors adaptation locale)</th>
                                        <th>S1</th>
                                        <th>S2</th>
                                        <th>S3</th>
                                        <th>S4</th>
                                        <th>S5</th>
                                        <th>S6</th>
                                        <th>Commentaires/explications</th>
                                    </tr>
                                    </thead>
                                    <tbody>
                                    <tr>
                                        <td class="text-start">« Utilisation éthique et responsable de l’Intelligence
                                            Artificielle (IA) »
                                        </td>
                                        {% for i in 1..6 %}
                                            <td>
                                                {{ structureCurrent[i].structureSemestre.ressources.ia }}
                                            </td>
                                        {% endfor %}
                                        <td><textarea class="form-control" name="ia_com" rows="1"></textarea></td>
                                    </tr>
                                    <tr>
                                        <td class="text-start">Problématiques TEDS</td>
                                        {% for i in 1..6 %}
                                            <td> {{ structureCurrent[i].structureSemestre.ressources.teds }}</td>
                                        {% endfor %}
                                        <td><textarea class="form-control" name="teds_com" rows="1"></textarea></td>
                                    </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <h3 class="h5 mb-3">Expression et LVE</h3>
                        <p class="font-weight-bold">Avez-vous modifié les volumes horaires affectés à l’expression et
                            aux LVE ?</p>
                        <div class="table-responsive mb-4">
                            <table class="table table-bordered align-middle text-center">
                                <thead class="table-light">
                                <tr>
                                    <th rowspan="2">Volume horaire (hors adaptation locale)</th>
                                    <th colspan="3">Expression</th>
                                    <th colspan="3">LVE1</th>
                                    <th colspan="2">LVE2</th>
                                    <th rowspan="2">Commentaires/explications</th>
                                </tr>
                                <tr>
                                    <th>2022</th>
                                    <th>2027</th>
                                    <th>diff.</th>
                                    <th>2022</th>
                                    <th>2027</th>
                                    <th>diff.</th>
                                    <th>2022</th>
                                    <th>2027</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for i in 1..6 %}
                                    <tr>
                                        <td class="font-weight-bold">S{{ i }}</td>
                                        <td> {{ structurePrevious[i].structureSemestre.ressources.expression }}</td>
                                        <td>
                                            {{ structureCurrent[i].structureSemestre.ressources.expression }}
                                        </td>
                                        <td>
                                            {% if structurePrevious[i].structureSemestre.ressources.expression != structureCurrent[i].structureSemestre.ressources.expression %}
                                                <span class="badge bg-danger">{{ structureCurrent[i].structureSemestre.ressources.expression - structurePrevious[i].structureSemestre.ressources.expression }}</span>
                                            {% else %}
                                                <span class="badge bg-success">Identique</span>
                                            {% endif %}
                                        </td>
                                        <td> {{ structurePrevious[i].structureSemestre.ressources.lve }}</td>
                                        <td>
                                            {{ structureCurrent[i].structureSemestre.ressources.lve }}
                                        </td>
                                        <td>
                                            {% if structurePrevious[i].structureSemestre.ressources.lve != structureCurrent[i].structureSemestre.ressources.lve %}
                                                <span class="badge bg-danger">{{ structureCurrent[i].structureSemestre.ressources.lve - structurePrevious[i].structureSemestre.ressources.lve }}</span>
                                            {% else %}
                                                <span class="badge bg-success">Identique</span>
                                            {% endif %}
                                        </td>

                                        <td><input type="text" class="form-control" name="lang_lve2_2022_s{{ i }}"></td>
                                        <td><input type="text" class="form-control" name="lang_lve2_2027_s{{ i }}"></td>
                                        <td><textarea class="form-control" name="lang_com_s{{ i }}" rows="1"></textarea>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>

                        <h3 class="h5 mb-3">Contenu des fiches ressources</h3>
                        <p class="font-weight-bold">Avez-vous modifié le contenu de fiches Ressources ? Dans quel
                            objectif ?</p>
                        <div class="table-responsive mb-4">
                            <table class="table table-bordered align-middle text-center">
                                <thead class="table-light">
                                <tr>
                                    <th></th>
                                    <th>Numéro de la ressource</th>
                                    <th>Commentaires/explications</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for i in 1..6 %}
                                    <tr>
                                        <td class="font-weight-bold">S{{ i }}</td>
                                        <td><input type="text" class="form-control" name="res_fiche_nb_s{{ i }}"></td>
                                        <td><textarea class="form-control" name="res_fiche_com_s{{ i }}"
                                                      rows="1"></textarea></td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </section>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end mb-5">
                        <button type="button"
                                class="btn btn-outline-secondary"
                                data-action="argumentaire-autosave#saveAll"
                        >
                            Sauvegarder le brouillon
                        </button>
                        <button type="submit" class="btn btn-primary btn-lg">Enregistrer l'argumentaire</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}
