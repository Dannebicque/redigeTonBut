<form method="post" action="{{ path }}" onsubmit="return confirm('{{ texte is defined ? texte : 'Êtes vous sûr de vouloir supprimer cet élément ?'}}');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ id) }}">
    <button class="btn btn-sm btn-icon btn-icon-start btn-outline-danger ms-1">
        <i class="bi-trash"></i>
        <span class="d-none d-xxl-inline-block">{{ label is defined ? label : 'Supprimer' }}</span>
    </button>
</form>
