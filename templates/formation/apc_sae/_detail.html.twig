<div class="row">
    <div class="col-md-6">
        <table class="table bg-white">
            {% if compareMode|default(false) and saeDiff is not null %}
                <tr>
                    <td colspan="2">
                        {% if saeDiff.status == 'added' %}
                            <span class="badge bg-success">Ajoutee depuis N-1</span>
                        {% elseif saeDiff.status == 'changed' %}
                            <span class="badge bg-warning text-dark">Modifiee par rapport a N-1</span>
                        {% else %}
                            <span class="badge bg-secondary">Identique a N-1</span>
                        {% endif %}
                    </td>
                </tr>
            {% endif %}
            <tr>
                <th>Parcours</th>
                <td>
                    {% for parcours in apc_sae.apcSaeParcours %}
                        <div class="d-flex mb-2">
                            <span class="badge badge-parcours-{{ parcours.parcours.couleur }} me-2">
                                {{ parcours.parcours.code }}
                            </span>
                            <div>{{ parcours.parcours.libelle }}</div>
                        </div>
                    {% else %}
                        <span class="badge bg-success">
                            Tous les parcours
                        </span>
                    {% endfor %}
                </td>
            </tr>
            <tr>
                <th>Code et Nom</th>
                <td>
                    {{ apc_sae.codeMatiere }} | {{ apc_sae.libelle }}
                    {% if compareMode|default(false) and saeDiff is not null and saeDiff.changes.libelle is defined %}
                        <br><small class="text-muted">N-1: {{ saeDiff.changes.libelle.old }}</small>
                    {% endif %}
                </td>
            </tr>
        </table>
    </div>
    <div class="col-md-6">
        <table class="table bg-white">
            <tr>
                <th>Semestre</th>
                <td>{{ apc_sae.semestre != null ? apc_sae.semestre.libelle : '-' }}</td>
            </tr>
            <tr>
                <th>Code et Nom</th>
                <td>Défini localement</td>
            </tr>
        </table>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <h3 class="mt-5 mb-3">Compétences ciblées</h3>
        {% if compareMode|default(false) and saeDiff is not null and saeDiff.linkedChanges is defined and (saeDiff.linkedChanges.competences.added|length > 0 or saeDiff.linkedChanges.competences.removed|length > 0) %}
            <div class="mb-2 small">
                {% for item in saeDiff.linkedChanges.competences.added %}
                    <span class="badge bg-success me-1">+ {{ item }}</span>
                {% endfor %}
                {% for item in saeDiff.linkedChanges.competences.removed %}
                    <span class="badge bg-danger me-1">- {{ item }}</span>
                {% endfor %}
            </div>
        {% endif %}
        {% for competence in apc_sae.apcSaeCompetences %}
            <div class="d-flex mb-2">
                <span class="badge badge-{{ competence.competence.couleur }} me-2">&nbsp;</span>
                <div>{{ competence.competence.libelle }}</div>
            </div>
        {% endfor %}

        <h3 class="mt-5 mb-3">Apprentissages critiques</h3>
        {% if compareMode|default(false) and saeDiff is not null and saeDiff.linkedChanges is defined and (saeDiff.linkedChanges.acs.added|length > 0 or saeDiff.linkedChanges.acs.removed|length > 0) %}
            <div class="mb-2 small">
                {% for item in saeDiff.linkedChanges.acs.added %}
                    <span class="badge bg-success me-1">+ {{ item }}</span>
                {% endfor %}
                {% for item in saeDiff.linkedChanges.acs.removed %}
                    <span class="badge bg-danger me-1">- {{ item }}</span>
                {% endfor %}
            </div>
        {% endif %}
        {% for ac in apc_sae.apcSaeApprentissageCritiques %}
            {% if ac.apprentissageCritique.competence != null  %}
            <div class="d-flex mb-2">
                <span class="badge badge-{{ ac.apprentissageCritique.competence.couleur }} me-2">{{ ac.apprentissageCritique.code }}</span>
                <div>{{ ac.apprentissageCritique.libelle }}</div>
            </div>
            {% else %}
            Erreur AC
                {% endif %}
        {% endfor %}

        <h3 class="mt-5 mb-3">Ressources mobilisées et combinées</h3>
        {% if compareMode|default(false) and saeDiff is not null and saeDiff.linkedChanges is defined and (saeDiff.linkedChanges.ressources.added|length > 0 or saeDiff.linkedChanges.ressources.removed|length > 0) %}
            <div class="mb-2 small">
                {% for item in saeDiff.linkedChanges.ressources.added %}
                    <span class="badge bg-success me-1">+ {{ item }}</span>
                {% endfor %}
                {% for item in saeDiff.linkedChanges.ressources.removed %}
                    <span class="badge bg-danger me-1">- {{ item }}</span>
                {% endfor %}
            </div>
        {% endif %}
        {% for ressource in ressources %}
            <div class="d-flex mb-2">
                <span class="badge bg-primary me-2">{{ ressource.ressource.codeMatiere }}</span>
                <div>{{ ressource.ressource.libelle }}</div>
            </div>
        {% endfor %}
    </div>
    <div class="col-md-6">
        <h3 class="mt-5">Objectifs et problématique professionnelle</h3>
        <p>{{ apc_sae.objectifs != null ? apc_sae.objectifs|markdown_to_html : '' }}</p>
        {% if compareMode|default(false) and saeDiff is not null and saeDiff.changes.objectifs is defined %}
            <div class="alert alert-warning small">
                <strong>Anciens objectifs (N-1)</strong><br>
                {{ saeDiff.changes.objectifs.old != null ? saeDiff.changes.objectifs.old|markdown_to_html : '' }}
            </div>
        {% endif %}
        <h3 class="mt-5">Descriptif générique</h3>
        <p>{{ apc_sae.description != null ? apc_sae.description|markdown_to_html : '' }}</p>
        {% if compareMode|default(false) and saeDiff is not null and saeDiff.changes.description is defined %}
            <div class="alert alert-warning small">
                <strong>Ancienne description (N-1)</strong><br>
                {{ saeDiff.changes.description.old != null ? saeDiff.changes.description.old|markdown_to_html : '' }}
            </div>
        {% endif %}
        {% if compareMode|default(false) and saeDiff is not null and (saeDiff.changes.portfolio is defined or saeDiff.changes.stage is defined or saeDiff.changes.ficheAdaptationLocale is defined) %}
            <h3 class="mt-5">Champs de fiche</h3>
            <div class="small">
                {% if saeDiff.changes.portfolio is defined %}
                    <div><strong>Portfolio:</strong> {{ saeDiff.changes.portfolio.old ? 'Oui' : 'Non' }} -> {{ saeDiff.changes.portfolio.new ? 'Oui' : 'Non' }}</div>
                {% endif %}
                {% if saeDiff.changes.stage is defined %}
                    <div><strong>Stage:</strong> {{ saeDiff.changes.stage.old ? 'Oui' : 'Non' }} -> {{ saeDiff.changes.stage.new ? 'Oui' : 'Non' }}</div>
                {% endif %}
                {% if saeDiff.changes.ficheAdaptationLocale is defined %}
                    <div><strong>Adaptation locale:</strong> {{ saeDiff.changes.ficheAdaptationLocale.old ? 'Oui' : 'Non' }} -> {{ saeDiff.changes.ficheAdaptationLocale.new ? 'Oui' : 'Non' }}</div>
                {% endif %}
            </div>
        {% endif %}
    </div>
    <div class="col-md-12">
        <h3 class="mt-4">Exemple de mise en place de SAE</h3>
        <table class="table table-bordered">
            <thead>
            <tr>
                <th>IUT</th>
                <th>Intitulé</th>
                <th>Voir</th>
            </tr>
            </thead>
            <tbody>
            {% for qapes in apc_sae.qapesSaes|filter(qapes => qapes.publiee == true) %}
                <tr>
                    <td>{{ qapes.iutSite != null ? qapes.iutSite.libelle : 'Erreur' }}</td>
                    <td>{{ qapes.intituleSae }}</td>
                    <td><a href="{{ path('app_qapes_sae_show', {id: qapes.id}) }}">Voir l'évaluation</a></td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="3">Aucune évaluation</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>


