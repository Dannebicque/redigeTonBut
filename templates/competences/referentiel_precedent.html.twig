{% extends 'base.html.twig' %}
{# todo : deprecated #}
{% block header %}
    Référentiel de compétences de : {{ departement.sigle }} - Version {{ annee }}
{% endblock %}

{% block content %}
    <ul class="nav nav-tabs nav-tabs-title nav-tabs-line-title responsive-tabs" id="lineTitleTabsContainer"
        role="tablist">
        <li class="nav-item" role="presentation">
            <a class="nav-link active" data-bs-toggle="tab" href="#complet" role="tab" aria-selected="true">Référentiel
                de compétences complet - Version {{ annee }}</a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link" data-bs-toggle="tab" href="#parcours" role="tab" aria-selected="false">Référentiel par
                parcours</a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link" data-bs-toggle="tab" href="#annee" role="tab" aria-selected="false">Référentiel par
                année</a>
        </li>
    </ul>
    <div class="tab-content mt-3">
        <div class="tab-pane active" id="complet" role="tabpanel">
            <section>
                <h2 class="small-title">Parcours de la spécialité {{ departement.sigle }}
                </h2>
                <div class="card mb-3">
                    <div class="card-body">
                        <ul class="nav nav-pills responsive-tabs nav-justified mb-4" role="tablist">
                            {% for parcourId, parcour in parcours %}
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link {% if loop.first %}active{% endif %} "
                                            data-bs-toggle="tab"
                                            data-bs-target="#parcour_comp_{{ parcourId }}" role="tab"
                                            aria-selected="false"
                                            type="button">{{ parcour.libelle }}</button>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>


                <div class="tab-content">
                    {% for parcourId, parcour in parcours %}
                        <div class="tab-pane {% if loop.first %}fade active show{% endif %}"
                             id="parcour_comp_{{ parcourId }}">
                            <section>
                                <h2 class="small-title">Compétences du parcours : {{ parcour.libelle }}</h2>
                                <div class="card mb-3">
                                    <div class="card-body">
                                        <ul class="nav nav-pills responsive-tabs nav-justified" role="tablist">
                                            {% for key,competence in competencesParcours[parcour.code] %}
                                                <li class="nav-item" role="presentation">
                                                    <button class="nav-link {% if loop.first %}active{% endif %}"
                                                            data-bs-toggle="tab"
                                                            data-bs-target="#competence_{{ key }}_{{ parcourId }}"
                                                            role="tab" aria-selected="false"
                                                            type="button">{{ competence|first.nom_court }}
                                                    </button>
                                                </li>
                                            {% endfor %}
                                        </ul>

                                        <div class="tab-content">
                                            {% for key, competence in competencesParcours[parcour.code] %}
                                                <div class="tab-pane {% if loop.first %}fade active show{% endif %}"
                                                     id="competence_{{ key }}_{{ parcourId }}">
                                                    {{ include('competences/_competencePrecedent.html.twig') }}
                                                </div>
                                            {% endfor %}
                                        </div>
                                    </div>
                                </div>
                            </section>
                        </div>
                    {% endfor %}
                </div>
            </section>
        </div>

        <div class="tab-pane" id="parcours" role="tabpanel">
            <section>
                <h2 class="small-title">Parcours de la spécialité {{ departement.sigle }}
                </h2>
                <div class="card">
                    <div class="card-body">
                        <ul class="nav nav-pills responsive-tabs nav-justified" role="tablist">
                            {% for parcourId, parcour in parcours %}
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link {% if loop.first %}active{% endif %}" data-bs-toggle="tab"
                                            data-bs-target="#parcour_{{ parcourId }}" role="tab" aria-selected="false"
                                            type="button">{{ parcour.libelle }}</button>
                                </li>
                            {% endfor %}
                        </ul>

                        <div class="tab-content">
                            {% for parcourId, parcour in parcours %}
                                <div class="tab-pane {% if loop.first %}fade active show{% endif %}"
                                     id="parcour_{{ parcourId }}">
                                    {{ include('competences/_parcourPrecedent.html.twig', {parcour: parcour}) }}
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <div class="tab-pane " id="annee" role="tabpanel">
            <section>
                <h2 class="small-title">Référentiel par année pour la spécialité {{ departement.sigle }}
                </h2>
                <div class="card">
                    <div class="card-body">
                        <ul class="nav nav-pills responsive-tabs nav-justified" role="tablist">
                            {% for annee in 1..3 %}
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link {% if loop.first %}active{% endif %}" data-bs-toggle="tab"
                                            data-bs-target="#annee_{{ annee }}" role="tab" aria-selected="false"
                                            type="button">
                                        Année {{ annee }}</button>
                                </li>
                            {% endfor %}
                        </ul>

                        <div class="tab-content">
                            {% for annee in 1..3 %}
                                <div class="tab-pane {% if loop.first %}fade active show{% endif %}"
                                     id="annee_{{ annee }}">
                                    {{ include('competences/_anneePrecedent.html.twig', {annee:'BUT'~annee}) }}
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </section>
        </div>
    </div>
{% endblock %}

{% block bouton_header %}
    {% if is_granted('COMPETENCES_EDIT', departement) %}

        <a href="{{ path('administration_apc_referentiel_index', {version:version.id}) }}" class="btn btn-sm
        btn-outline-info
            btn-icon btn-icon-end w-100 w-sm-auto mx-2"
        >
            <i class="bi-shuffle"></i>
            <span>Basculer sur la version en cours de travail (2027)</span>
        </a>
    {% endif %}
{% endblock %}

