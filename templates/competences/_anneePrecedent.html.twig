{# todo: deprecated #}

{% for competence in competences %}
    {% for niveau in competence.niveaux|filter(niveau => (niveau.annee != null and niveau.annee == annee)) %}
        <div class="d-flex align-items-stretch mt-3">
            <div class="col-2 competence ">
                <div class="p-3 comp competence{{ competence.couleur }}">{{ competence.nom_court }}</div>
            </div>
            <div class="col-2 niveau niveau{{ niveau.ordre }}{{ competence.couleur }}">
                <div class="p-3 niveaulong">
                    {{ competence.libelle_long }}
                </div>
            </div>
            <div class="col-8">
                {% if niveau.acs|length > 0 %}
                    <div class="p-3 niveauliste niveau{{ niveau.ordre }}{{ competence.couleur }}">
                        <ul>
                            {% for ac in niveau.acs %}
                                <li>{{ ac.code }} | {{ ac.libelle }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
            </div>
        </div>
    {% endfor %}
{% endfor %}
