{% extends 'base.html.twig' %}

{% block header %}Détail du parcours : {{ apcParcours.libelle }}{% endblock %}

{% block content %}
    <div class="card">
        <div class="card-body">
            <table class="table">
                <tbody>
                <tr>
                    <th>Libelle</th>
                    <td>{{ apcParcours.libelle }}</td>
                </tr>

                <tr>
                    <th>Code</th>
                    <td>{{ apcParcours.code }}</td>
                </tr>
                <tr>
                    <th>Ordre</th>
                    <td>{{ apcParcours.ordre }} (si 0, l'ordre alphabétique s'applique)</td>
                </tr>

                <tr>
                    <th>Texte descriptif</th>
                    <td>{{ apcParcours.textePresentation != null ? apcParcours.textePresentation|markdown_to_html|raw : '' }}</td>
                </tr>

                </tbody>
            </table>
        </div>
    </div>
{% endblock %}

{% block bouton_header %}
    {% if is_granted('COMPETENCES_EDIT', user_data.departement) or is_granted('ROLE_ADMIN') %}
        {% if annee == 2027 %}
            <a href="{{ path('administration_apc_parcours_show_version', {id: apcParcours.id, annee:2027}) }}" class="btn btn-sm
                    btn-outline-info
                        btn-icon btn-icon-end w-100 w-sm-auto mx-2"
            >
                <i class="bi-shuffle"></i>
                <span>Comparer les versions</span>
            </a>
        {% endif %}
    {% endif %}
{% endblock %}


