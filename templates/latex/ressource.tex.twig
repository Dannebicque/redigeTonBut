{% set prerequisListe = ressource.ressourcesPreRequisesOrdre(semestre, parcours) %}

{% if prerequisListe|length > 0 %}
\textbf{Pr\'erequis : }

\begin{itemize}
{% for prerequis in prerequisListe %}
    \item[--] {{ prerequis.codeMatiere|latex_purge }} | {{ prerequis.libelle|latex_purge|raw }}
{% endfor %}
\end{itemize}
{% endif %}

{% set apprentissagesGroupes = ressource.apcRessourceApprentissageCritiquesOrdre(parcours) %}
{% set nbApprentissages = 0 %}

{% for groupe in apprentissagesGroupes %}
{% set nbApprentissages = nbApprentissages + groupe|length %}
{% endfor %}

{% if nbApprentissages > 1 %}
\textbf{Apprentissages critiques cibl\'es : }
{% else %}
\textbf{Apprentissage critique cibl\'e : }
{% endif %}

{% if nbApprentissages > 0 %}
\begin{itemize}
{% for groupe in apprentissagesGroupes %}
{% for ac in groupe %}
    \item[--] {{ ac.code|latex_purge }} | {{ ac.libelle|latex_purge|raw }}
{% endfor %}
{% endfor %}
\end{itemize}
{% else %}
--- Pas d'apprentissage critique associ\'e ---
{% endif %}

